{
  "name": "packing-list",
  "version": "0.3.4",
  "description": "Obsidian plugin for managing packing lists — reset checkboxes, track items, and create new lists from templates.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "lefthook install"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@12.4.1",
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@types/node": "25.9.6",
    "builtin-modules": "5.3.0",
    "esbuild": "0.28.2",
    "lefthook": "2.1.12",
    "obsidian": "latest",
    "prettier": "3.9.6",
    "tslib": "2.8.1",
    "typescript": "7.0.2"
  }
}
